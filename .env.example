# RogueByte POS & ERP - Production Environment Variables Configuration

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# PostgreSQL Database Connection URL (for local self-hosted deployments)
DATABASE_URL="postgresql://roguebyte_user:secure_password@localhost:5432/roguebyte_erp?schema=public"

# Regional & Currency Settings
DEFAULT_CURRENCY="OMR"
DEFAULT_DECIMAL_PLACES=3
TIMEZONE="Asia/Muscat"
DEFAULT_TAX_RATE=0.05

# Security & Sessions
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-key-min-64-bytes"
SESSION_EXPIRY_HOURS=12

# AI Studio Injection Parameters
GEMINI_API_KEY="MY_GEMINI_API_KEY"
